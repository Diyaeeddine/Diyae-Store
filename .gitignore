# Ignore node_modules (dependencies)
node_modules/

# Ignore Next.js build and cache files
.next/
out/
.vercel/
dist/

# Ignore environment variables (secrets)
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# Ignore editor-specific files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Ignore package lock files (if using a specific package manager)
# Uncomment only if you want to ignore lock files (not recommended for production)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Ignore TypeScript build files (if using TypeScript)
*.tsbuildinfo

# Ignore MacOS system files
*.DS_Store

# Ignore Windows system files
Thumbs.db

# Ignore Linux system files
*~

# Ignore optional Firebase or Supabase folders (if using)
.firebase/
supabase/

# Ignore coverage reports (if using Jest or testing tools)
coverage/
